# Reportes de pruebas (artefactos generados, no código)
pruebas/reportes/

# Config de pilotos con credenciales reales (NO subir). Se versiona el .example.
pruebas/*.config.js

# Plantillas/Excels de carga de clientes (pueden contener claves fiscales reales)
plantilla_carga_clientes*.xlsx
*_clientes.xlsx
clientes_*.xlsx

# Datos de la app generados al correrla (se crean solos en cada máquina).
