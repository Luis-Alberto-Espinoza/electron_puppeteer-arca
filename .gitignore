*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/
vendor/

# Environment files
.env
.env.*

# Compiled source
dist/
build/
coverage/

# Laravel specific
/public/storage
/storage/*.key
/storage/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*

# Ignorar imágenes y PDFs subidos al proyecto
