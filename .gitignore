/.env.production
/.env.staging

# Specific for Docker
docker-compose.override.yml
docker-compose-dev.yml

# Angular files (si se usa en el proyecto)
.angular/*
.angular/cache/

# Ignorar backups
*.bak
*.backup

# Otros archivos específicos de tu proyecto
/resources/js/temp/  # Ajustar si aplica
/public/temp/         # Carpeta temporal en public

